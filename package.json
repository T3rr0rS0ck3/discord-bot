{
    "name": "discord-bot",
    "version": "1.0.0",
    "private": true,
    "description": "Minimal Discord bot scaffold with TypeScript",
    "main": "dist/index.js",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "dev:admin": "esbuild src/admin-ui/main.tsx --bundle --platform=browser --target=es2020 --format=iife --outfile=dist/admin/app.js --watch",
        "build:admin": "esbuild src/admin-ui/main.tsx --bundle --platform=browser --target=es2020 --format=iife --outfile=dist/admin/app.js",
        "build": "npm run clean && npm run typecheck && npm run build:admin && esbuild src/index.ts --bundle --packages=external --platform=node --target=node22 --format=cjs --outfile=dist/index.js",
        "publish": "docker compose build",
        "start": "node dist/index.js",
        "dev": "concurrently \"npm:dev:admin\" \"tsx watch src/index.ts\""
    },
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@snazzah/davey": "^0.1.11",
        "discord.js": "^14.26.0",
        "emojibase-data": "^16.0.1",
        "ffmpeg-static": "^5.3.0",
        "opusscript": "^0.1.1",
        "play-dl": "^1.9.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1",
        "yt-dlp-exec": "^1.0.2"
    },
    "devDependencies": {
        "@types/node": "^22.15.3",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "concurrently": "^9.2.1",
        "esbuild": "^0.25.9",
        "tsx": "^4.20.5",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
