{
    "name": "discord-bot",
    "version": "1.0.0",
    "private": true,
    "description": "Minimal Discord bot scaffold with TypeScript",
    "main": "dist/index.js",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build": "npm run clean && npm run typecheck && esbuild src/index.ts --bundle --packages=external --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "probe:voice": "tsx src/voiceProbe.ts"
    },
    "dependencies": {
        "@discordjs/voice": "^0.18.0",
        "@snazzah/davey": "^0.1.11",
        "discord.js": "^14.26.0",
        "dotenv": "^16.6.1",
        "opusscript": "^0.1.1",
        "ffmpeg-static": "^5.3.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.3",
        "esbuild": "^0.25.9",
        "tsx": "^4.20.5",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=20"
    }
}